message: "If you use this data or code, please cite it as below, and cite the paper (preferred-citation)."
type: dataset
title: "Data for Schema Change in the Wild: a census of state migrations in Urbit, 2013–2026"
version: 1.0.0
authors:
  - family-names: Davis
    given-names: Neal E.
    orcid: "https://orcid.org/0000-0002-1131-8319"
    affiliation: ZeroAttest
license:
  - CC-BY-4.0
